{
  "name": "@sleuth/cli",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "sleuth": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json --resolve-full-paths",
    "test": "vitest run --passWithNoTests --exclude \"**/node_modules/**\" --exclude \"**/.git/**\" --exclude src/__tests__/analyze.e2e.test.ts",
    "test:watch": "vitest",
    "test:e2e": "vitest run src/__tests__/analyze.e2e.test.ts"
  },
  "dependencies": {
    "@sleuth/core": "*",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "inquirer": "^10.1.8",
    "ora": "^8.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/inquirer": "^9.0.7",
    "@types/node": "^20.14.15",
    "typescript": "^5.5.4"
  }
}
