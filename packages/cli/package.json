{
  "name": "sleuth-cli",
  "version": "1.0.1",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "sleuth": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "npm run build",
    "test": "vitest run --passWithNoTests --exclude \"**/node_modules/**\" --exclude \"**/.git/**\" --exclude src/__tests__/analyze.e2e.test.ts",
    "test:watch": "vitest",
    "test:e2e": "vitest run src/__tests__/analyze.e2e.test.ts"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.2",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "ignore": "^5.3.2",
    "inquirer": "^10.1.8",
    "ora": "^8.1.0",
    "simple-git": "^3.25.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@sleuth/core": "*",
    "@types/inquirer": "^9.0.7",
    "@types/node": "^20.14.15",
    "esbuild": "^0.28.1",
    "typescript": "^5.5.4"
  }
}
